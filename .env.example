# Frontend build variables for NotaNota. Copy to .env.local (git-ignored) and fill in what you need.
# Every value here ends up in the public JavaScript bundle: never put a server secret in a VITE_ variable
# (no META_API_KEY, no service-role key). Those live only in Supabase Edge Function secrets.
# With everything blank the practice studio works on its own; accounts and AI stay off.
# To try NotaNota AI without any setup, use the live app: https://notanota.online

# Supabase project URL, e.g. https://<project-ref>.supabase.co (accounts, streaks, leaderboards).
VITE_SUPABASE_URL=
# The project's publishable (anon) key, e.g. sb_publishable_... It is public by design and protected by RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=
# "true" shows Google sign-in; the Google provider must be enabled in Supabase Auth first.
VITE_GOOGLE_AUTH_ENABLED=false

# NotaNota AI gateway. Accepted only when it is https://<project-ref>.supabase.co/functions/v1/ai-gateway of
# the same project as VITE_SUPABASE_URL (or an http://localhost mock); anything else is ignored.
# The gateway also needs its migrations and server secrets: see docs/archive/ai-staging-b3.md and README.md.
VITE_AI_GATEWAY_URL=
# "true" only when the score library migration (supabase/migrations/202611040001_score_library.sql) is applied.
VITE_SCORE_LIBRARY=false
# "true" only when the learning profile migrations (202611040002, 202611040003) are applied.
VITE_LEARNING_PROFILE=false
