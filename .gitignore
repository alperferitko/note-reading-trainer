# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/
/out-pages/

# misc
.DS_Store
*.pem
*.key
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/tmp/
/.npm-cache/
/.git/
/.sites-git/
/.tools/

# local package cache
/.npm-cache/

# generated build output (preserve the Sites Vite source plugin)
/build/*
!/build/sites-vite-plugin.ts

# Cloudflare local secrets
.dev.vars
.dev.vars.*

# local AI tooling (preserve the hosting declaration imported by Vite)
/.openai/*
!/.openai/hosting.json
/.agents/

# local databases
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# TypeScript cache
*.tsbuildinfo

# allow public environment variable template
!.env.example
