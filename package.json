{
  "name": "note-reading-trainer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "start": "vinext start",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/account-deletion-audit.test.mjs tests/audio-system.test.mjs tests/score-reading.test.mjs tests/rhythm-glyphs.test.mjs tests/learning-path.test.mjs tests/music-pitch.test.mjs tests/notation-rendering.test.mjs tests/site-features.test.mjs tests/session-guidance.test.mjs tests/pulse-practice.test.mjs tests/lesson-review.test.mjs tests/ear-training.test.mjs tests/reading-studies.test.mjs tests/practice-evidence.test.mjs tests/sql-checks.test.mjs",
    "test:pages": "node --test tests/pages-build.test.mjs",
    "test:ai": "node --test tests/ai-contracts.test.mjs tests/ai-gateway.test.mjs",
    "test:ai:http": "node --test tests/ai-http.test.mjs",
    "test:ai:learning": "node --test tests/ai-learning.test.mjs",
    "test:ai:b3": "node --test tests/ai-b3.test.mjs",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "test:sql": "node scripts/verify-leaderboard-sql.mjs",
    "test:ai:b4": "node --test tests/edge-bundle.test.mjs tests/ai-ledger-pglite.test.mjs tests/ai-client.test.mjs tests/ai-meta-config.test.mjs",
    "test:features": "node --test tests/musicxml.test.mjs tests/pitch-detect.test.mjs tests/practice-plan.test.mjs tests/ode-satb.test.mjs",
    "sync:edge": "node scripts/sync-edge-shared.mjs",
    "test:edge:deno": "cd supabase/functions/ai-gateway && npx -y deno@2.5.6 task check && npx -y deno@2.5.6 task test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "opensheetmusicdisplay": "2.2.1",
    "pitchy": "4.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "0.5.14",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
